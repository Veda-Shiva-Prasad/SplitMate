# Copy to server/.env (git-ignored) for running the API without Docker.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/splitmate
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Extra allowed browser origins, comma separated (your deployed frontend URL).
CLIENT_URL=http://localhost:3000
